{
  "expo": {
    "name": "Thuận Lê Studio",
    "slug": "thuan-le",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "thuanle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cho phép thu giọng ngân nga để chuyển thành giai điệu trong phòng sáng tác."
      },
      "bundleIdentifier": "com.thuanlevan.studio",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A192F",
        "foregroundImage": "./assets/brand/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thuanlevan.studio",
      "versionCode": 2,
      "icon": "./assets/brand/app-icon.png",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon.png",
      "name": "Thuận Lê Studio",
      "shortName": "TL Studio",
      "lang": "vi",
      "description": "Phòng sáng tác nhạc: viết lời tiếng Việt, khám phá hợp âm, tạo giai điệu, phối khí và chơi piano.",
      "themeColor": "#0A192F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A192F",
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0A192F",
            "image": "./assets/brand/splash-logo.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép thu giọng ngân nga để chuyển thành giai điệu.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Phòng sáng tác nhạc: viết lời tiếng Việt, khám phá hợp âm, tạo giai điệu, phối khí và chơi piano.",
    "primaryColor": "#0284C7",
    "extra": {
      "studio": {
        "brand": "Thuận Lê Studio",
        "tagline": "Viết lời. Tìm hợp âm. Chơi giai điệu.",
        "website": "https://thuanlevan.vercel.app/studio"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "37eb9d87-796f-4885-8f96-ca40afa7bab0"
      }
    },
    "owner": "sonboszlai"
  }
}

{
  "name": "thuan-le",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "dexie": "^4.4.7",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-screen-orientation": "~58.0.4",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.80.0",
    "pitchy": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tonal": "^6.9.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/cli": "^4.3.5"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "studio:css": "tailwindcss -i ./src/studio/studio.input.css -o ./src/studio/studio.css --minify",
    "prestart": "npm run studio:css",
    "typecheck": "tsc --noEmit",
    "test:studio": "node --experimental-strip-types --test src/studio/utils/*.test.ts",
    "preweb": "npm run studio:css",
    "preios": "npm run studio:css",
    "preandroid": "npm run studio:css",
    "studio:samples": "node scripts/generate-studio-samples.cjs",
    "check:release": "npm run studio:css && npm run typecheck && npm run lint && npm run test:studio && npm run check:assets",
    "build:apk": "npx eas-cli@latest build --platform android --profile release-apk",
    "build:aab": "npx eas-cli@latest build --platform android --profile production",
    "eas-build-post-install": "npm run studio:css && npm run check:assets",
    "check:assets": "node scripts/check-brand-assets.cjs"
  },
  "private": true
}
